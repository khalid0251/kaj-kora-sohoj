# Generative AI Inpainting Configuration
# ============================================

# Selected Provider: stability, openai, or replicate
AI_INPAINT_PROVIDER=stability

# Stability AI API Key (Recommended)
# Sign up and get your API key from: https://platform.stability.ai/account/keys
STABILITY_API_KEY=your_stability_api_key_here

# OpenAI API Key (Optional fallback for DALL-E Inpainting)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Replicate API Token (Optional fallback)
# Get your API token from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
